{
	"name": "@jannis6023/prisma-class-generator",
	"version": "0.6.0",
	"description": "Maintained and fixed Class generator from Prisma schema (contains Class-Validator / Class-Transformer and Swagger Decorators)",
	"main": "dist/index.js",
	"license": "MIT",
	"keywords": [
		"prisma",
		"nestjs",
		"typescript",
		"generator"
	],
	"homepage": "https://github.com/jannis6023/prisma-class-generator",
	"repository": {
		"type": "git",
		"url": "git://github.com/jannis6023/prisma-class-generator.git"
	},
	"scripts": {
		"format": "prettier --write \"src/**/*.ts\"",
		"dev": "node -r ts-node/register src/index.ts",
		"generate:postgresql": "prisma generate --schema prisma/postgresql.prisma",
		"generate:mysql": "prisma generate --schema prisma/mysql.prisma",
		"generate:mongodb": "prisma generate --schema prisma/mongodb.prisma"
	},
	"bin": {
		"prisma-class-generator": "dist/bin.js"
	},
	"engines": {
		"node": ">=14"
	},
	"author": {
		"name": "kimjbstar",
		"email": "kimjbstar@gmail.com"
	},
	"dependencies": {
		"@prisma/client": "^6.0.0",
		"@prisma/generator-helper": "^6.0.0",
		"@prisma/internals": "^6.0.0",
		"change-case": "^4.1.2",
		"prettier": "2.5.1"
	},
	"devDependencies": {
		"@nestjs/swagger": "^11.4.7",
		"@types/jest": "^28.1.4",
		"@types/node": "^24.10.2",
		"@types/prettier": "^2.6.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"prisma": "^6.0.0",
		"swagger-ui-express": "^4.4.0",
		"ts-node": "^10.9.1",
		"ts-toolbelt": "^9.6.0",
		"typescript": "^5.9.3"
	},
	"_moduleAliases": {
		"@src": "dist"
	}
}
